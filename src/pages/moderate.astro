---
// Private moderation page for reader comments. Not linked anywhere, noindex, out of the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Moderate comments | CheckVitalsNow" description="Comment moderation." noindex>
  <section class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6" data-moderate>
    <h1 class="text-3xl font-bold">Moderate comments</h1>
    <form class="mt-6 flex flex-wrap gap-3" data-login>
      <label for="admin-token" class="sr-only">Admin password</label>
      <input id="admin-token" type="password" autocomplete="current-password" placeholder="Admin password (ADMIN_TOKEN)" class="min-w-0 flex-1 rounded-lg border border-line px-3 py-2" />
      <button class="rounded-lg bg-brand-700 px-5 py-2 font-semibold text-white">Open</button>
    </form>
    <div class="mt-6 flex gap-3" data-tabs hidden>
      <button data-status="pending" class="rounded-lg border border-line px-4 py-2 font-semibold">Waiting for review</button>
      <button data-status="approved" class="rounded-lg border border-line px-4 py-2 font-semibold">Published</button>
    </div>
    <p class="mt-4 text-base" data-msg role="status"></p>
    <ol class="mt-4 space-y-4" data-list></ol>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-moderate]');
    const list = root.querySelector('[data-list]');
    const msg = root.querySelector('[data-msg]');
    const tabs = root.querySelector('[data-tabs]');
    let token = sessionStorage.getItem('cvn-admin') || '';
    let current = 'pending';

    const api = (method, body, query = '') =>
      fetch('/api/admin/comments' + query, {
        method,
        headers: { authorization: 'Bearer ' + token, 'content-type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      }).then(async (r) => ({ ok: r.ok, data: await r.json().catch(() => ({})) }));

    const load = async () => {
      list.replaceChildren();
      msg.textContent = 'Loading…';
      const { ok, data } = await api('GET', null, '?status=' + current);
      if (!ok) {
        msg.textContent = data.error || 'Could not load comments.';
        tabs.hidden = true;
        return;
      }
      sessionStorage.setItem('cvn-admin', token);
      tabs.hidden = false;
      msg.textContent = data.comments.length + (current === 'pending' ? ' waiting for review' : ' published');
      for (const c of data.comments) {
        const li = document.createElement('li');
        li.className = 'rounded-xl border border-line p-5';
        const meta = document.createElement('p');
        meta.className = 'text-sm text-muted';
        meta.textContent = c.created_at + ' UTC · ' + c.path;
        const who = document.createElement('p');
        who.className = 'mt-1 font-semibold';
        who.textContent = c.name;
        const body = document.createElement('p');
        body.className = 'mt-1 whitespace-pre-line';
        body.textContent = c.body;
        const actions = document.createElement('p');
        actions.className = 'mt-3 flex gap-3';
        const btn = (label, action, cls) => {
          const b = document.createElement('button');
          b.textContent = label;
          b.className = 'rounded-lg px-4 py-2 font-semibold ' + cls;
          b.onclick = async () => {
            if (action === 'delete' && !confirm('Delete this comment?')) return;
            const { ok, data } = await api('POST', { id: c.id, action });
            if (ok) li.remove();
            else alert(data.error || 'Error');
          };
          return b;
        };
        if (c.status === 'pending') actions.append(btn('Approve', 'approve', 'bg-brand-700 text-white'));
        actions.append(btn('Delete', 'delete', 'border border-line'));
        li.append(meta, who, body, actions);
        list.append(li);
      }
    };

    root.querySelector('[data-login]').addEventListener('submit', (e) => {
      e.preventDefault();
      token = root.querySelector('#admin-token').value.trim();
      load();
    });
    tabs.addEventListener('click', (e) => {
      const s = e.target.dataset.status;
      if (s) {
        current = s;
        load();
      }
    });
    if (token) load();
  })();
</script>
