---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, disclaimers, standards, promises } from '../data/site';

const all = await getCollection('articles');
const byId = (id: string) => all.find((a) => a.id === id);

// Homepage shelves, grouped the way readers usually look for help.
const topics = [
  {
    id: 'bladder-health',
    title: 'Bladder health',
    intro: 'Leaks, urgency, and too many bathroom trips are common, and most of the first steps are free.',
    ids: [
      'why-do-i-leak-urine-when-i-sneeze',
      'kegel-exercises-for-women',
      'frequent-urination-in-women',
      'bladder-irritants-foods-and-drinks',
      'menopause-and-bladder-leakage',
    ],
  },
  {
    id: 'hormones-and-menopause',
    title: 'Hormones and menopause',
    intro: 'What changes in your 40s and 50s, what is normal, and when to get checked.',
    ids: ['perimenopause-symptoms', 'signs-of-hormonal-imbalance-in-women', 'bone-health-after-menopause'],
  },
  {
    id: 'energy-and-stress',
    title: 'Energy and stress',
    intro: 'Why you might feel drained all the time, and the habits that help your body recover.',
    ids: ['why-am-i-always-tired', 'how-to-lower-cortisol-naturally'],
  },
].map((t) => ({ ...t, articles: t.ids.map(byId).filter((a): a is (typeof all)[number] => Boolean(a)) }));

// "Start here" picks: one guide from each topic.
const featured = ['why-do-i-leak-urine-when-i-sneeze', 'perimenopause-symptoms', 'why-am-i-always-tired']
  .map(byId)
  .filter((a): a is (typeof all)[number] => Boolean(a));

const sitePages = [
  { label: 'About us', href: '/about/', text: 'Who we are and what we cover.' },
  { label: 'How we write', href: '/editorial-policy/', text: 'Our sources, our process, and how we fix mistakes.' },
  { label: 'Medical disclaimer', href: '/medical-disclaimer/', text: 'Why our guides are not a substitute for your doctor.' },
  { label: 'Privacy policy', href: '/privacy-policy/', text: 'What data the site collects and your choices.' },
  { label: 'Terms of use', href: '/terms-of-use/', text: 'The rules for using this website.' },
  { label: 'Contact', href: '/contact/', text: 'Report an error or suggest a topic.' },
];

const title = "CheckVitalsNow: Women's Health Guides You Can Trust";
const description =
  "Plain-language women's health guides on bladder leakage, perimenopause, hormones, fatigue, stress, and bone health, built on trusted medical sources.";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${site.url}/`,
    description,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/favicon-512x512.png`,
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="border-b border-line bg-brand-50">
    <div class="container-page py-14 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">Women's health, explained plainly</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">Straight answers about the changes no one warned you about</h1>
      <div class="prose-width mt-6 space-y-4 text-lg text-ink">
        <p>
          You leak a little when you sneeze. You wake up at 3 a.m. soaked in sweat. You are tired no matter how much you
          sleep. These things are common, and they are also easy to brush off, by friends, by search results, and
          sometimes by ourselves.
        </p>
        <p>
          {site.name} publishes clear, sourced guides for women who want to understand what is going on in their bodies
          and what may help. Every guide links its medical sources and tells you when it is time to see a doctor.
        </p>
      </div>
      <nav aria-label="Topics" class="mt-8">
        <p class="text-sm font-semibold text-muted">Jump to a topic:</p>
        <ul class="mt-3 flex flex-wrap gap-3">
          {
            topics.map((t) => (
              <li>
                <a
                  href={`#${t.id}`}
                  class="inline-flex rounded-full border border-brand-700 bg-paper px-4 py-2 text-base font-semibold text-brand-700 no-underline hover:bg-brand-100"
                >
                  {t.title}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/womens-health/"
              class="inline-flex rounded-full bg-brand-700 px-4 py-2 text-base font-semibold text-white no-underline hover:bg-brand-900"
              >All guides</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="start-here">
    <h2 id="start-here" class="text-3xl font-bold">Start here</h2>
    <p class="prose-width mt-3 text-muted">Three good places to begin, one from each topic.</p>
    <ul class="mt-8 grid gap-6 lg:grid-cols-3">
      {
        featured.map((a) => (
          <li class="flex flex-col rounded-2xl border border-brand-100 bg-brand-50 p-6">
            <h3 class="text-2xl font-bold">
              <a href={`/${a.data.category}/${a.id}/`} class="text-brand-900 no-underline hover:text-brand-700">
                {a.data.h1}
              </a>
            </h3>
            <p class="mt-3 text-base">{a.data.keyTakeaways[0]}</p>
            <a href={`/${a.data.category}/${a.id}/`} class="mt-auto pt-4 text-base font-semibold">
              Read the guide →
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    topics.map((topic, i) => (
      <section id={topic.id} class:list={['scroll-mt-6 border-t border-line', i % 2 === 0 && 'bg-soft']} aria-labelledby={`topic-${i}`}>
        <div class="container-page py-14">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id={`topic-${i}`} class="text-3xl font-bold">
              {topic.title}
            </h2>
            <span class="text-sm text-muted">
              {topic.articles.length} {topic.articles.length === 1 ? 'guide' : 'guides'}
            </span>
          </div>
          <p class="prose-width mt-3 text-muted">{topic.intro}</p>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {topic.articles.map((a) => (
              <li class="rounded-xl border border-line bg-paper p-6">
                <h3 class="text-xl font-bold">
                  <a href={`/${a.data.category}/${a.id}/`} class="text-brand-900 no-underline hover:text-brand-700">
                    {a.data.h1}
                  </a>
                </h3>
                <p class="mt-2 text-base text-muted">{a.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="container-page py-14" aria-labelledby="standards-title">
    <h2 id="standards-title" class="text-3xl font-bold">How we write our guides</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        standards.map((s) => (
          <li class="rounded-xl border border-line bg-paper p-6">
            <h3 class="text-xl font-bold">{s.name}</h3>
            <p class="mt-2 text-base text-muted">{s.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-base">
      Read our full <a href="/editorial-policy/">editorial policy</a> or learn more <a href="/about/">about us</a>.
    </p>
  </section>

  <section class="border-t border-line bg-soft" aria-labelledby="promise-title">
    <div class="container-page grid gap-10 py-14 lg:grid-cols-2">
      <div>
        <h2 id="promise-title" class="text-3xl font-bold">Our promise to readers</h2>
        <ul class="mt-6 space-y-3">
          {
            promises.map((p) => (
              <li class="flex gap-3">
                <svg aria-hidden="true" class="mt-1.5 h-5 w-5 flex-none text-brand-600" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="self-start rounded-xl border border-line bg-paper p-6">
        <h2 class="text-2xl font-bold">Talk to your doctor first</h2>
        <p class="mt-3 text-base">{disclaimers.medical}</p>
      </div>
    </div>
  </section>
  <section class="border-t border-line" aria-labelledby="site-pages">
    <div class="container-page py-14">
      <h2 id="site-pages" class="text-3xl font-bold">About this site</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          sitePages.map((p) => (
            <li class="rounded-xl border border-line p-5">
              <a href={p.href} class="font-serif text-lg font-bold text-brand-900 no-underline hover:text-brand-700">
                {p.label}
              </a>
              <p class="mt-1 text-base text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
