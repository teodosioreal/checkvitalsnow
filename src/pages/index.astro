---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, disclaimers } from '../data/site';

const articles = (await getCollection('articles')).sort((a, b) => a.data.h1.localeCompare(b.data.h1)).slice(0, 6);

const title = 'CheckVitalsNow: Honest Supplement Reviews';
const description =
  'Independent supplement reviews that check the formula, ingredient research, price, guarantee, and customer feedback, so you can decide before you buy.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: `${site.url}/`,
    description,
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: `${site.url}/`,
    logo: `${site.url}/favicon-512x512.png`,
  },
];

const whatWeCover = [
  {
    title: 'Product reviews',
    text: 'One supplement at a time: what it is, what is in it, how it is supposed to work, what it costs, and who should skip it.',
  },
  {
    title: 'Ingredient research',
    text: 'We check what published research says about each key ingredient, and we tell you when the evidence is thin.',
  },
  {
    title: 'Buying safely',
    text: 'Where a product is officially sold, how the refund policy works, and how to avoid look-alike or counterfeit bottles.',
  },
];

const steps = [
  {
    name: 'Ingredients',
    text: 'Is each ingredient backed by research for the use the label suggests? Is the dose disclosed and in a sensible range?',
  },
  {
    name: 'Transparency',
    text: 'Does the manufacturer show a full label, explain who makes the product, and avoid claims it cannot support?',
  },
  {
    name: 'Value',
    text: 'What does a realistic month of use cost compared with similar products?',
  },
  {
    name: 'Guarantee',
    text: 'How long is the refund window, what are the conditions, and is it easy to use?',
  },
  {
    name: 'Customer feedback',
    text: 'What are buyers saying in public, both good and bad? We summarize patterns and never invent quotes.',
  },
];

const reviews = [
  {
    title: 'NerveCalm Review',
    href: '/nervecalm-scam-or-legit-nervecalm-full-review/',
    summary: 'What NerveCalm is, its ingredients, pros and cons, guarantee, and where to buy it.',
  },
  {
    title: 'FemiPro Review',
    href: '/femipro-review-scam-or-legit-femipro-full-review/',
    summary: 'What FemiPro claims, the ingredients most often listed, what the research says, and who should skip it.',
  },
];

const promises = [
  'We never publish fake testimonials, made-up ratings, or invented "user results."',
  'We never claim a supplement cures, treats, or prevents a disease.',
  'We never use fake countdowns or "only 3 left" pressure.',
  'Every review lists real downsides, not just selling points.',
  'We do not run lab tests or clinical trials, and we will not pretend we did.',
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="border-b border-line bg-brand-50">
    <div class="container-page py-14 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">Supplement reviews for real people</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">Honest supplement reviews, before you spend a dollar</h1>
      <div class="prose-width mt-6 space-y-4 text-lg text-ink">
        <p>
          You saw an ad for a supplement that promises better sleep, less joint pain, or more energy. The page looks
          convincing, the reviews are glowing, and there is a timer counting down. Before you order, you want a straight
          answer: does this thing hold up?
        </p>
        <p>
          That is what we do at {site.name}. Our supplement reviews look at the formula, the research behind each
          ingredient, the price, the refund policy, and what real customers are saying in public. Then we tell you plainly
          who a product might suit, who should skip it, and where to buy it safely.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#latest-reviews"
          class="inline-flex items-center rounded-lg bg-brand-700 px-5 py-3 text-base font-semibold text-white no-underline hover:bg-brand-900"
          >Browse our reviews</a
        >
        <a
          href="#how-we-review"
          class="inline-flex items-center rounded-lg border border-brand-700 px-5 py-3 text-base font-semibold text-brand-700 no-underline hover:bg-brand-100"
          >How we review</a
        >
      </div>
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="what-we-cover">
    <h2 id="what-we-cover" class="text-3xl font-bold">What you will find here</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {
        whatWeCover.map((item) => (
          <li class="rounded-xl border border-line bg-paper p-6">
            <h3 class="text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-base text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="how-we-review" class="scroll-mt-6 border-y border-line bg-soft" aria-labelledby="how-we-review-title">
    <div class="container-page py-14">
      <h2 id="how-we-review-title" class="text-3xl font-bold">How we review supplements</h2>
      <p class="prose-width mt-4">
        Every review is based on the official formula, the ingredient research, the manufacturer's policies, and publicly
        available customer feedback. We score each product on the same five criteria, so you can compare one review with
        another.
      </p>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="rounded-xl border border-line bg-paper p-6">
              <p class="text-sm font-semibold text-brand-700">Criterion {i + 1}</p>
              <h3 class="mt-1 text-xl font-bold">{step.name}</h3>
              <p class="mt-2 text-base text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-page py-14" aria-labelledby="our-promise">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 id="our-promise" class="text-3xl font-bold">What we will never do</h2>
        <p class="mt-4">
          The supplement world is full of pages that look like reviews but are really sales pitches. We hold ourselves to
          a different standard:
        </p>
        <ul class="mt-6 space-y-3">
          {
            promises.map((p) => (
              <li class="flex gap-3">
                <svg aria-hidden="true" class="mt-1.5 h-5 w-5 flex-none text-brand-600" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="space-y-6">
        <div class="rounded-xl border border-line bg-brand-50 p-6">
          <h2 class="text-2xl font-bold">How we make money</h2>
          <p class="mt-3 text-base">
            Some of our reviews include affiliate links. If you buy through one, we may earn a commission at no extra cost
            to you. This doesn't influence our evaluations, and every page with affiliate links says so at the top.
          </p>
        </div>
        <div class="rounded-xl border border-line bg-paper p-6">
          <h2 class="text-2xl font-bold">Talk to your doctor first</h2>
          <p class="mt-3 text-base">{disclaimers.medical}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-soft" aria-labelledby="guides-title">
    <div class="container-page py-14">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="guides-title" class="text-3xl font-bold">Women's health guides</h2>
        <a href="/womens-health/" class="text-base font-semibold">See all guides</a>
      </div>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((a) => (
            <li class="rounded-xl border border-line bg-paper p-6">
              <h3 class="text-xl font-bold">
                <a href={`/${a.data.category}/${a.id}/`} class="text-brand-900 no-underline hover:text-brand-700">
                  {a.data.h1}
                </a>
              </h3>
              <p class="mt-2 text-base text-muted">{a.data.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="latest-reviews" class="scroll-mt-6 border-t border-line" aria-labelledby="latest-reviews-title">
    <div class="container-page py-14">
      <h2 id="latest-reviews-title" class="text-3xl font-bold">Latest supplement reviews</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          reviews.map((r) => (
            <li class="rounded-xl border border-line bg-paper p-6">
              <h3 class="text-xl font-bold">
                <a href={r.href} class="text-brand-900 no-underline hover:text-brand-700">
                  {r.title}
                </a>
              </h3>
              <p class="mt-2 text-base text-muted">{r.summary}</p>
              <a href={r.href} class="mt-4 inline-block text-base font-semibold">
                Read the review
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
