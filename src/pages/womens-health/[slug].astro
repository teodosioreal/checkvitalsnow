---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import FAQ from '../../components/FAQ.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import ReviewPromo from '../../components/ReviewPromo.astro';
import { site, categories, author } from '../../data/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.category === 'womens-health');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;
const category = categories[data.category];
const url = new URL(Astro.url.pathname, site.url).href;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const iso = (d: Date) => d.toISOString().slice(0, 10);
// Unsplash requires hotlinking; imgix params resize and convert on their CDN.
const unsplash = (raw: string, w: number) =>
  `${raw}${raw.includes('?') ? '&' : '?'}w=${w}&h=${Math.round((w * 9) / 16)}&fit=crop&crop=entropy&fm=webp&q=70`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.h1,
    description: data.description,
    datePublished: iso(data.datePublished),
    dateModified: iso(data.dateModified),
    author: { '@type': 'Organization', name: author.name, url: `${site.url}/` },
    publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/`, logo: `${site.url}/favicon-512x512.png` },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: category.name, item: `${site.url}/${data.category}/` },
      { '@type': 'ListItem', position: 3, name: data.h1, item: url },
    ],
  },
];
if (data.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<BaseLayout title={data.title} description={data.description} ogType="article" jsonLd={jsonLd}>
  <article class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/" class="text-muted">Home</a>
      <span aria-hidden="true"> / </span>
      <a href={`/${data.category}/`} class="text-muted">{category.name}</a>
    </nav>
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">{data.h1}</h1>
    <p class="mt-4 text-sm text-muted">
      By {author.name} · Published <time datetime={iso(data.datePublished)}>{fmt(data.datePublished)}</time>
      {
        iso(data.dateModified) !== iso(data.datePublished) && (
          <>
            {' '}
            · Last updated <time datetime={iso(data.dateModified)}>{fmt(data.dateModified)}</time>
          </>
        )
      }
    </p>
    {
      data.image && (
        <Image
          src={data.image}
          alt={data.imageAlt ?? ''}
          width={1200}
          class="mt-8 w-full rounded-xl"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    {
      data.cover && (
        <figure class="mt-8">
          <img
            src={unsplash(data.cover.url, 1200)}
            srcset={[640, 960, 1200, 1600].map((w) => `${unsplash(data.cover!.url, w)} ${w}w`).join(', ')}
            sizes="(min-width: 768px) 720px, 100vw"
            width="1200"
            height="675"
            alt={data.cover.alt}
            class="aspect-video w-full rounded-xl bg-soft object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption class="mt-2 text-xs text-muted">
            Photo by <a href={data.cover.authorUrl} rel="noopener" target="_blank" class="text-muted">{data.cover.author}</a> on{' '}
            <a href={data.cover.photoUrl} rel="noopener" target="_blank" class="text-muted">Unsplash</a>
          </figcaption>
        </figure>
      )
    }
    <KeyTakeaways items={data.keyTakeaways} />
    <TableOfContents headings={headings} />
    <div class="article-body">
      <Content />
    </div>
    {data.promo && <ReviewPromo product={data.promo} />}
    <FAQ items={data.faq} />
    <section class="mt-12" aria-labelledby="sources-title">
      <h2 id="sources-title" class="mb-3 text-2xl font-bold">Sources</h2>
      <ol class="list-decimal space-y-1 pl-5 text-sm">
        {
          data.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                {s.title}
              </a>
            </li>
          ))
        }
      </ol>
    </section>
    <RelatedArticles ids={data.related} />
  </article>
</BaseLayout>
