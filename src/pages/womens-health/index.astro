---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { site, categories } from '../../data/site';

const category = categories['womens-health'];
const articles = (await getCollection('articles', ({ data }) => data.category === 'womens-health')).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime() || a.data.h1.localeCompare(b.data.h1),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: category.name, item: `${site.url}/womens-health/` },
    ],
  },
];
---

<BaseLayout
  title="Women's Health Guides | CheckVitalsNow"
  description="Practical, medically sourced guides on bladder leakage, hormones, fatigue, stress, and bone health for women."
  jsonLd={jsonLd}
>
  <section class="border-b border-line bg-brand-50">
    <div class="container-page py-12">
      <h1 class="text-4xl font-bold">{category.name}</h1>
      <p class="prose-width mt-4">{category.description}</p>
    </div>
  </section>
  <section class="container-page py-12">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((a) => <ArticleCard article={a} level="h2" />)
      }
    </ul>
  </section>
</BaseLayout>
