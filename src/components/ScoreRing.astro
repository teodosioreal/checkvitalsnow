---
import '@fontsource/anton/latin-400.css';

interface Props {
  score: number;
  size?: number;
}
const { score, size = 120 } = Astro.props;
const r = 40;
const c = 2 * Math.PI * r;
const filled = (Math.max(0, Math.min(10, score)) / 10) * c;
---

<svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={`Score ${score.toFixed(1)} out of 10`} class="flex-none">
  <circle cx="50" cy="50" r={r} fill="#fff" stroke="#c4c4c4" stroke-width="11"></circle>
  <circle
    cx="50"
    cy="50"
    r={r}
    fill="none"
    stroke="#22a10e"
    stroke-width="11"
    stroke-dasharray={`${filled} ${c}`}
    transform="rotate(-90 50 50)"></circle>
  <text
    x="50"
    y="58"
    text-anchor="middle"
    font-size="22"
    fill="#000"
    font-family="Anton, Impact, 'Arial Narrow Bold', sans-serif"
    font-weight="400"
    letter-spacing="-0.5">{score.toFixed(1)}/10</text
  >
</svg>
