---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-12" aria-labelledby="faq-title">
      <h2 id="faq-title" class="mb-4 text-3xl font-bold">
        Frequently asked questions
      </h2>
      <div class="divide-y divide-line rounded-xl border border-line">
        {items.map((item) => (
          <details class="group p-5">
            <summary class="cursor-pointer list-none font-semibold text-ink marker:hidden">
              <span class="flex items-start justify-between gap-4">
                {item.q}
                <span aria-hidden="true" class="text-brand-700 transition-transform group-open:rotate-45">
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
