---
import { goUrl } from '../data/products';

interface Props {
  product: string;
  variant?: 'button' | 'link';
  class?: string;
}

const { product, variant = 'button', class: className = '' } = Astro.props;
const href = goUrl(product);
const styles =
  variant === 'button'
    ? 'inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3.5 text-center text-lg font-semibold text-white no-underline shadow-sm transition-colors hover:bg-accent-hover'
    : 'font-semibold';
---

<a href={href} rel="sponsored nofollow noopener" target="_blank" class:list={[styles, className]}><slot /></a>
