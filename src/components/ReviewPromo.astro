---
import { Image } from 'astro:assets';
import femiproBottle from '../assets/reviews/femipro/femipro-bottle.png';

const promos = {
  femipro: {
    href: '/femipro-review-scam-or-legit-femipro-full-review/',
    image: femiproBottle,
    alt: 'FemiPro supplement bottle',
    eyebrow: 'Our honest review',
    title: 'Seen the FemiPro ads? Read this before you order.',
    text: 'We looked past the marketing: what is actually in FemiPro, what the research does and doesn’t show, the one ingredient women who are pregnant or breastfeeding should avoid, and how to dodge look-alike websites. No hype, just what you need to decide.',
    button: 'Read our FemiPro review',
  },
} as const;

const lists = {
  'bladder-supplements-for-women': {
    href: '/best/bladder-supplements-for-women/',
    text: 'Comparing options? See how it stacks up against 4 other bladder supplements in our top 5',
  },
} as const;

interface Props {
  product: keyof typeof promos;
  compare?: keyof typeof lists;
}

const promo = promos[Astro.props.product];
const list = Astro.props.compare ? lists[Astro.props.compare] : undefined;
---

<aside class="mt-12 overflow-hidden rounded-2xl border border-brand-100 bg-brand-50" aria-labelledby={`promo-${Astro.props.product}`}>
  <div class="grid items-center gap-6 p-6 sm:grid-cols-[150px_1fr] sm:p-8">
    <a href={promo.href} class="mx-auto block no-underline" tabindex="-1" aria-hidden="true">
      <Image src={promo.image} alt="" width={150} densities={[1, 2]} class="h-auto w-32 sm:w-full" />
    </a>
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">{promo.eyebrow}</p>
      <h2 id={`promo-${Astro.props.product}`} class="mt-1 text-2xl font-bold">{promo.title}</h2>
      <p class="mt-3 text-base">{promo.text}</p>
      <a
        href={promo.href}
        class="mt-5 inline-flex items-center rounded-lg bg-brand-700 px-5 py-3 text-base font-semibold text-white no-underline hover:bg-brand-900"
        >{promo.button} →</a
      >
      {
        list && (
          <p class="mt-4 text-base">
            <a href={list.href} class="font-semibold">
              {list.text} →
            </a>
          </p>
        )
      }
    </div>
  </div>
</aside>
