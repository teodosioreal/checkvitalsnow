---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  location: string;
  photo: ImageMetadata;
}

const { name, location, photo } = Astro.props;
---

<figure class="flex gap-4 rounded-xl border border-line bg-paper p-5">
  <Image src={photo} alt={`Photo of ${name}`} width={64} height={64} densities={[1, 2]} class="h-16 w-16 flex-none rounded-full object-cover" />
  <div>
    <figcaption class="text-base">
      <span class="font-semibold text-ink">{name}</span>
      <span class="text-amber-600" aria-label="5 out of 5 stars">★★★★★</span>
      <span class="block text-sm text-muted">{location}</span>
    </figcaption>
    <blockquote class="mt-2 text-base"><slot /></blockquote>
  </div>
</figure>
