---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<aside class="my-8 rounded-xl border border-brand-100 bg-brand-50 p-6" aria-labelledby="key-takeaways">
  <h2 id="key-takeaways" class="!mb-3 !mt-0 font-sans !text-base font-bold uppercase tracking-wider text-brand-700">
    Key takeaways
  </h2>
  <ul class="list-disc space-y-2 pl-5 text-base">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</aside>
