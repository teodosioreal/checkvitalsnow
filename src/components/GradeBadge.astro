---
interface Props {
  grade: string;
  size?: number;
}
const { grade, size = 120 } = Astro.props;
const letter = grade.charAt(0);
const mod = grade.slice(1); // "+", "-" or ""
---

<div class="flex flex-none flex-col items-center">
  <svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={`Overall grade ${grade.replace('-', ' minus').replace('+', ' plus')}`}>
    <text
      x={mod ? 44 : 50}
      y="86"
      text-anchor="middle"
      font-size="96"
      font-weight="900"
      fill="#000"
      font-family="'Arial Black', 'Helvetica Neue', Arial, sans-serif">{letter}</text
    >
    {
      mod === '+' && (
        <path d="M86 18v20M76 28h20" stroke="#000" stroke-width="5" stroke-linecap="round" />
      )
    }
    {mod === '-' && <path d="M76 28h20" stroke="#000" stroke-width="5" stroke-linecap="round" />}
  </svg>
  <span class="-mt-1 text-xs font-semibold uppercase tracking-wider text-muted">Overall grade</span>
</div>
