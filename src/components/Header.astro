---
import { site, nav } from '../data/site';
---

<header class="border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2"
    >Skip to content</a
  >
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label={`${site.name} home`}>
      <svg aria-hidden="true" width="32" height="32" viewBox="0 0 32 32">
        <rect width="32" height="32" rx="8" fill="#0e5a6b"></rect>
        <path
          d="M6 17h5l2.5-6 4 11 3-8 1.5 3H26"
          fill="none"
          stroke="#fff"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="font-serif text-xl font-bold text-brand-900">Check<span class="text-brand-600">Vitals</span>Now</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex gap-5 text-base">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="font-medium text-ink no-underline hover:text-brand-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
