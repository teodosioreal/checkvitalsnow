---
import { site, categories } from '../data/site';
import { getPublishedArticles } from '../lib/articles';

// Show only sections that already have live articles.
const published = await getPublishedArticles();
const nav = [
  ...Object.entries(categories)
    .filter(([slug]) => published.some((a) => a.data.category === slug))
    .map(([slug, c]) => ({ label: c.name, href: `/${slug}/` })),
  { label: 'About', href: '/about/' },
];
---

<header class="border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-paper focus:px-3 focus:py-2"
    >Skip to content</a
  >
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4">
    <a href="/" class="flex items-center gap-2 no-underline" aria-label={`${site.name} home`}>
      <svg aria-hidden="true" width="36" height="36" viewBox="0 0 64 64">
        <defs>
          <linearGradient id="logo-g" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#16879a"></stop>
            <stop offset="1" stop-color="#0b3f4c"></stop>
          </linearGradient>
        </defs>
        <circle cx="32" cy="32" r="32" fill="url(#logo-g)"></circle>
        <path
          d="M10 34h8.5l5-10 7.5 18L51 20"
          fill="none"
          stroke="#fff"
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="font-serif text-xl font-bold text-brand-900">Check<span class="text-brand-600">Vitals</span>Now</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex gap-5 text-base">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="font-medium text-ink no-underline hover:text-brand-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
