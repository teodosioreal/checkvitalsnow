---
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';
import { legalUpdated } from '../data/owner.mjs';
import { noindexPaths } from '../data/noindex.mjs';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Show the "Last updated" line (legal and policy pages). */
  updated?: boolean;
  /** schema.org page type, e.g. AboutPage or ContactPage. */
  pageType?: string;
}

const { title, description, h1, updated = true, pageType = 'WebPage' } = Astro.props;
const url = new URL(Astro.url.pathname, site.url).href;
const updatedDate = new Date(`${legalUpdated}T12:00:00Z`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': pageType,
    name: h1,
    url,
    description,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'WebSite', name: site.name, url: `${site.url}/` },
    ...(updated ? { dateModified: legalUpdated } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: h1, item: url },
    ],
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} noindex={noindexPaths.includes(Astro.url.pathname)}>
  <section class="border-b border-line bg-brand-50">
    <div class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
      <nav aria-label="Breadcrumb" class="text-sm">
        <a href="/" class="text-muted">Home</a>
        <span class="text-muted" aria-hidden="true"> / </span>
        <span class="text-muted" aria-current="page">{h1}</span>
      </nav>
      <h1 class="mt-3 text-4xl font-bold">{h1}</h1>
      {
        updated && (
          <p class="mt-3 text-sm text-muted">
            Last updated:{' '}
            <time datetime={legalUpdated}>
              {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
          </p>
        )
      }
    </div>
  </section>
  <div class="article-body mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
    <slot />
  </div>
</BaseLayout>
